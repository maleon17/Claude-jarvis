[Unit]
Description=Claude Jarvis backend worker
Documentation=https://github.com/maleon17/claude-ask
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__INSTALL_DIR__
Environment=PATH=/home/__USER__/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Optional: owner name/id for the persona template, and chats where the
# persona's profanity is suppressed. Written by setup.sh; '-' = ok if absent.
EnvironmentFile=-__INSTALL_DIR__/jarvis.env
Environment=CLAUDE_JARVIS_MCP_CONFIG=__INSTALL_DIR__/mcp_telegram_tools_config.json
Environment=CLAUDE_JARVIS_ASK_QUEUE=/tmp/jarvisask_ask_queue/
Environment=CLAUDE_JARVIS_ASK_RESULT=/tmp/jarvisask_ask_result/
ExecStart=/usr/bin/python3 -u __INSTALL_DIR__/claude_watcher.py
Restart=always
RestartSec=3
KillMode=control-group
TimeoutStopSec=20
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
